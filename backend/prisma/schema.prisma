generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  /// Case-insensitive uniqueness is enforced by users_email_lower_uidx in SQL.
  email                String
  passwordHash         String            @map("password_hash")
  displayName          String            @map("display_name")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens        RefreshToken[]
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  comments             Comment[]
  attachments          Attachment[]

  @@map("users")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

  @@map("workspace_role")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  /// Non-blank names are enforced by workspaces_name_not_blank in SQL.
  name        String
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  members     WorkspaceMember[]
  invitations Invitation[]
  projects    Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  /// A partial SQL index enforces unique LOWER(email) per workspace for pending invitations.
  email       String
  tokenHash   String           @unique @map("token_hash")
  role        WorkspaceRole
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([workspaceId])
  @@map("invitations")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED

  @@map("project_status")
}

enum ProjectRole {
  MANAGER
  MEMBER

  @@map("project_role")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  name        String
  status      ProjectStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members     ProjectMember[]
  tasks       Task[]

  @@index([workspaceId, status])
  @@map("projects")
}

model ProjectMember {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  role          ProjectRole
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedTasks Task[]

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  parentId       String?        @map("parent_id") @db.Uuid
  assigneeId     String?        @map("assignee_id") @db.Uuid
  title          String
  description    String
  status         TaskStatus     @default(TODO)
  priority       TaskPriority
  dueDate        DateTime?      @map("due_date") @db.Date
  estimatedHours Decimal?       @map("estimated_hours")
  position       Int
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent         Task?          @relation("TaskTree", fields: [projectId, parentId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  subtasks       Task[]         @relation("TaskTree")
  comments       Comment[]
  attachments    Attachment[]
  assignee       ProjectMember? @relation(fields: [projectId, assigneeId], references: [projectId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, id])
  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([projectId, parentId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// PostgreSQL rejects whitespace-only bodies.
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId, createdAt])
  @@map("comments")
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  uploaderId String   @map("uploader_id") @db.Uuid
  objectKey  String   @unique @map("object_key")
  filename   String
  mimeType   String   @map("mime_type")
  /// PostgreSQL limits attachments to 1–10,485,760 bytes.
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId])
  @@map("attachments")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
